---
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const links = [
  { href: '/wiki/camera-gear', label: 'OVERVIEW' },
  { href: '/wiki/camera-gear/archive', label: 'ARCHIVE' },
  { href: '/wiki/camera-gear/kits', label: 'KITS' },
  { href: '/wiki/camera-gear/compare', label: 'COMPARE' },
];
const isDetail = pathname.startsWith('/wiki/camera-gear/') && !links.some(link => link.href === pathname);
---
<nav class="gear-navigation" aria-label="Gear navigation">
  <ul>{links.map(({ href, label }) => <li>
    <a href={href} aria-current={pathname === href ? 'page' : isDetail && href === '/wiki/camera-gear/archive' ? 'location' : undefined}>{label}</a>
  </li>)}</ul>
</nav>
<style>
  .gear-navigation { margin-block-end: var(--space-8); border-block-end: 1px solid var(--color-border); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-7); list-style: none; padding: 0; margin: 0; }
  a { display: inline-flex; align-items: center; min-block-size: 2.75rem; padding-block: var(--space-3); font-size: var(--font-size-caption); letter-spacing: var(--letter-spacing-label); }
  @media (max-width: 25rem) { ul { column-gap: var(--space-5); } }
</style>


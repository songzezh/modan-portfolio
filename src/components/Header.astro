---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/work', label: 'WORK' },
  { href: '/journal', label: 'JOURNAL' },
  { href: '/wiki', label: 'WIKI' },
  { href: '/about', label: 'ABOUT' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="MÒ DÀN / 漠澹 — Home" aria-current={pathname === '/' ? 'page' : undefined}>
    <span class="brand-name">MÒ DÀN</span>
    <span class="brand-divider" aria-hidden="true"></span>
    <span class="brand-chinese" lang="zh-Hans">漠澹</span>
  </a>
  <nav aria-label="Main navigation">
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={pathname === href ? 'page' : pathname.startsWith(`${href}/`) ? 'location' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="header-tools"><ThemeToggle /></div>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-5);
    padding-block: var(--space-5) 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-4);
    min-block-size: 2.75rem;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  a.brand[aria-current='page'] {
    font-style: italic;
    text-decoration-line: none;
  }

  .brand-name {
    font-family: var(--font-family-editorial);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.035em;
  }

  .brand-divider {
    inline-size: 1px;
    block-size: 1rem;
    background: var(--color-border);
  }

  .brand-chinese {
    font-family: var(--font-family-editorial);
    font-size: var(--font-size-small);
    letter-spacing: 0.18em;
  }

  nav {
    grid-column: 1 / -1;
    grid-row: 2;
    min-inline-size: 0;
    margin-block: var(--space-4) var(--space-3);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-block-size: 2.75rem;
    padding-inline: var(--space-1);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-caption);
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-color),
      background-color var(--duration-fast) var(--ease-color);
  }

  nav a::before {
    content: '';
    position: absolute;
    inset-block-end: 4px;
    inset-inline-start: calc(50% - 2px);
    inline-size: 4px;
    flex: 0 0 4px;
    block-size: 4px;
    border-radius: 50%;
    background: transparent;
    transition: background-color var(--duration-fast) var(--ease-color);
  }

  nav a[aria-current] {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  nav a[aria-current]::before {
    background: currentColor;
  }

  nav a:focus-visible {
    color: var(--color-primary);
    background: var(--color-primary-soft);
    outline-offset: 2px;
    text-decoration: none;
    transition: none;
  }

  nav a:active {
    background: var(--color-primary-soft);
    transition-duration: 0ms;
  }

  .header-tools {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--color-primary);
      background: var(--color-surface);
      text-decoration: none;
    }
    nav a[aria-current]:hover { background: var(--color-primary-soft); }
  }

  @media (min-width: 48rem) {
    .site-header {
      grid-template-columns: minmax(0, 1fr) auto auto;
      column-gap: var(--space-6);
      padding-block: var(--space-5);
    }

    nav {
      grid-column: 2;
      grid-row: 1;
      margin-block: 0;
    }

    ul { grid-template-columns: repeat(4, auto); }
    nav a { padding-inline: clamp(0.75rem, 1.5vw, 1.5rem); }
    nav a::before { position: static; }

    .header-tools {
      grid-column: 3;
      padding-inline-start: var(--space-6);
      border-inline-start: 1px solid var(--color-border);
    }
  }
</style>

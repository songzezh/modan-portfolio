---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/work', label: 'Work' },
  { href: '/journal', label: 'Journal' },
  { href: '/wiki', label: 'Wiki' },
  { href: '/about', label: 'About' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="MÒ DÀN / 漠澹 — Home" aria-current={pathname === '/' ? 'page' : undefined}>
    <span class="brand-name">MÒ DÀN</span>
    <span class="brand-divider" aria-hidden="true"></span>
    <span class="brand-chinese" lang="zh-Hans">漠澹</span>
  </a>
  <nav aria-label="Main navigation">
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={pathname === href ? 'page' : pathname.startsWith(`${href}/`) ? 'location' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="header-tools"><ThemeToggle /></div>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-5);
    padding-block: var(--space-5) 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--space-4);
    min-block-size: 2.75rem;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  a.brand[aria-current='page'] {
    font-style: italic;
    font-weight: 700;
    text-decoration-line: none;
  }

  .brand-name {
    font-family: var(--font-family-editorial);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.035em;
  }

  .brand-divider {
    inline-size: 1px;
    block-size: 1rem;
    background: var(--color-border);
  }

  .brand-chinese {
    font-family: var(--font-family-editorial);
    font-size: var(--font-size-small);
    letter-spacing: 0.18em;
  }

  nav {
    grid-column: 1 / -1;
    grid-row: 2;
    min-inline-size: 0;
    margin-block: var(--space-4) var(--space-3);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    padding-inline: var(--space-1);
    font-family: var(--font-family-editorial);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    font-style: italic;
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-caption);
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-color);
  }

  nav a[aria-current] {
    color: var(--color-text-muted);
    font-weight: 700;
    text-decoration: none;
  }

  nav a:focus-visible {
    color: var(--color-primary);
    outline-offset: 2px;
    text-decoration: none;
    transition: none;
  }

  .header-tools {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--color-primary);
      text-decoration: none;
    }
  }

  @media (min-width: 48rem) {
    .site-header {
      grid-template-columns: minmax(0, 1fr) auto auto;
      column-gap: var(--space-6);
      padding-block: var(--space-5);
    }

    nav {
      grid-column: 2;
      grid-row: 1;
      margin-block: 0;
    }

    ul { grid-template-columns: repeat(4, auto); }
    nav a { padding-inline: clamp(0.75rem, 1.5vw, 1.5rem); }

    .header-tools {
      grid-column: 3;
      padding-inline-start: var(--space-6);
      border-inline-start: 1px solid var(--color-border);
    }
  }
</style>

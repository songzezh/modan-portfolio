---
import type { availableGearFilters } from '../lib/gear-filters';
interface Props { filters: ReturnType<typeof availableGearFilters> }
const { filters } = Astro.props;
---
<div class="filter-fields">{filters.map(filter => <label for={`gear-filter-${filter.key}`}>{filter.label}
  <select id={`gear-filter-${filter.key}`} name={filter.key} aria-controls="gear-list"><option value="">All</option>
    {filter.options.map(option => <option value={option.value}>{option.label}</option>)}
  </select>
</label>)}</div>
<style>
  .filter-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--space-5) var(--space-6); }
  label { display: grid; gap: var(--space-2); font-size: var(--font-size-caption); color: var(--color-text-muted); min-inline-size: 0; }
  select { inline-size: 100%; min-inline-size: 0; min-block-size: 2.75rem; background: var(--color-bg); color: var(--color-primary); border: 0; border-block-end: 1px solid var(--color-border); border-radius: 0; padding: var(--space-2) 0; font-size: var(--font-size-small); }
  @media (min-width: 48rem) { .filter-fields { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>


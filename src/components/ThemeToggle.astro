<button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" title="Switch to dark theme" hidden>
  <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" />
  </svg>
  <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (button) {
    const applyTheme = (dark: boolean) => {
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      button.setAttribute('aria-pressed', String(dark));
      button.title = dark ? 'Switch to light theme' : 'Switch to dark theme';
    };

    applyTheme(document.documentElement.dataset.theme === 'dark');
    button.hidden = false;
    button.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      applyTheme(dark);
      try {
        localStorage.setItem('modan-theme', dark ? 'dark' : 'light');
      } catch {
        // Switching still works when browser storage is unavailable.
      }
    });
    window.addEventListener('storage', (event) => {
      if (event.key === 'modan-theme' || event.key === null) {
        applyTheme(event.newValue === 'dark');
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
  }

  .theme-toggle[hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover { background: var(--color-primary-soft); border-color: var(--color-primary); }
  }
  .sun { display: none; }
  :global([data-theme='dark']) .sun { display: block; }
  :global([data-theme='dark']) .moon { display: none; }

</style>

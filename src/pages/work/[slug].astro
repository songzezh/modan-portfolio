---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, getImageSrcSet } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project, previous, next } = Astro.props;
const { title, subtitle, description, location, year, images, placeholder } = project.data;
---

<BaseLayout title={`${title} — MODAN / 漠澹`} description={description}>
  <article aria-labelledby="project-title">
    <header class="project-intro">
      <div>
        <p class="project-subtitle">{subtitle}</p>
        <h1 id="project-title">{title}</h1>
        <dl class="project-metadata">
          {location && <div><dt>Location</dt><dd>{location}</dd></div>}
          {year && <div><dt>Year</dt><dd><time datetime={String(year)}>{year}</time></dd></div>}
          <div><dt>Photographs</dt><dd>{String(images.length).padStart(2, '0')}</dd></div>
        </dl>
      </div>
      <div class="project-description">
        <p>{description}</p>
        {placeholder && <p class="placeholder-note">Placeholder photography</p>}
      </div>
    </header>

    <div class="photobook">
      {images.map((image, index) => (
        <figure class:list={['photobook-image', `photobook-image--${image.orientation}`]}>
          <a class="photograph-link" href={`/work/${project.data.slug}/${image.id}`} aria-label={`View details for ${image.title}`}>
          <img src={image.src} srcset={getImageSrcSet(image)}
            sizes={image.orientation === 'portrait'
              ? '(min-width: 1600px) 690px, (min-width: 640px) 44vw, 92vw'
              : image.orientation === 'square'
                ? '(min-width: 1600px) 864px, (min-width: 640px) 55vw, 92vw'
                : '(min-width: 1600px) 1440px, 92vw'}
            width={image.width} height={image.height} alt={image.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
          </a>
          <figcaption><span>{image.title}</span>{image.caption && <small>{image.caption}</small>}</figcaption>
        </figure>
      ))}
    </div>
  </article>

  <nav class="project-navigation" aria-label="Project navigation">
    {previous && <a class="previous-project" href={`/work/${previous.data.slug}`} rel="prev">
      <span class="direction">Previous project</span>
      <span>{previous.data.title}</span>
    </a>}
    <a class="all-projects" href="/work">All work</a>
    {next && <a class="next-project" href={`/work/${next.data.slug}`} rel="next">
      <span class="direction">Next project</span>
      <span>{next.data.title}</span>
    </a>}
  </nav>
</BaseLayout>

<style>
  .project-intro { display: grid; gap: var(--space-7); margin-block-end: var(--section-spacing); }
  .project-subtitle, .project-metadata, .placeholder-note {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  h1 { max-inline-size: 20ch; margin-block-end: var(--space-7); }
  .project-metadata { display: flex; flex-wrap: wrap; gap: var(--space-5) var(--space-7); margin: 0; }
  dt { font-size: var(--font-size-caption); margin-block-end: var(--space-1); }
  dd { margin: 0; color: var(--color-text); }
  dd time { color: inherit; }
  .project-description { max-inline-size: 42ch; }
  .project-description p:last-child { margin: 0; }
  .photobook { display: grid; gap: var(--image-series-gap); }
  .photobook-image { min-inline-size: 0; inline-size: 100%; }
  .photobook-image img { inline-size: 100%; }
  .photograph-link { display: block; }
  .photograph-link:hover img { opacity: 0.94; }
  .photograph-link img { transition: opacity var(--duration-fast) var(--ease-standard); }
  figcaption { display: grid; gap: var(--space-1); max-inline-size: var(--content-width-text); }
  figcaption small { color: var(--color-text-muted); font-size: var(--font-size-caption); }
  .project-navigation {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--section-spacing);
    padding-block-start: var(--space-7);
    border-block-start: 1px solid var(--color-border);
  }
  .project-navigation a { display: flex; flex-direction: column; padding-block: var(--space-3); color: var(--color-text); }
  .project-navigation a:hover, .project-navigation a:focus-visible { color: var(--color-primary); }
  .direction { color: var(--color-text-muted); font-size: var(--font-size-caption); margin-block-end: var(--space-2); }
  .all-projects { font-size: var(--font-size-small); justify-self: start; text-decoration-line: underline; }
  @media (min-width: 40rem) {
    .project-intro { grid-template-columns: 3fr 2fr; gap: var(--space-8); }
    .project-description { padding-block-start: var(--space-7); }
    .photobook-image { inline-size: 88%; justify-self: start; }
    .photobook-image:nth-child(even) { justify-self: end; }
    .photobook-image:nth-child(3n) { inline-size: 100%; }
    .photobook-image--portrait, .photobook-image--portrait:nth-child(3n) { inline-size: 48%; }
    .photobook-image--square, .photobook-image--square:nth-child(3n) { inline-size: 60%; }
    .project-navigation { grid-template-columns: 1fr auto 1fr; gap: var(--space-7); align-items: start; }
    .previous-project { grid-column: 1; grid-row: 1; }
    .all-projects { grid-column: 2; grid-row: 1; }
    .next-project { grid-column: 3; grid-row: 1; justify-self: end; text-align: end; }
  }
</style>

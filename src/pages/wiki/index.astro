---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/wiki.css';
---

<BaseLayout title="Photography Wiki — MODAN / 漠澹" description="A photography knowledge index: basics, camera gear, composition, lighting, practice, post-processing, workflow, history, ethics, and terminology.">
        <section
          class="topics-section section"
          id="topics"
          aria-labelledby="topics-title"
        >
          <header class="section-heading">
            <p class="eyebrow">THE INDEX</p>
            <h1 id="topics-title">Photography Index</h1>
          </header>

          <div class="topic-grid" role="list">
            <article class="topic-card featured" role="listitem">
              <span class="topic-index">A / 01</span>
              <span class="topic-symbol" aria-hidden="true">◎</span>
              <div>
                <h2>Photography Basics</h2>
                <p>
                  Understand exposure, focus, depth of field, and how images are
                  made.
                </p>
                <span class="topic-keywords"
                  >Aperture · Shutter Speed · ISO</span
                >
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">A / 02</span>
              <div>
                <h2>Camera Gear</h2>
                <p>
                  Explore cameras, lenses, and essential accessories to suit
                  your photography.
                </p>
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">A / 03</span>
              <div>
                <h2>Composition &amp; Visual Language</h2>
                <p>Build your frame with subjects, lines, space, and color.</p>
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">A / 04</span>
              <div>
                <h2>Light &amp; Lighting</h2>
                <p>
                  Observe natural light and learn the fundamentals of artificial
                  lighting.
                </p>
              </div>
            </article>

            <article class="topic-card wide" role="listitem">
              <span class="topic-index">B / 01</span>
              <div>
                <h2>Genres &amp; Practice</h2>
                <p>
                  Portraits, landscapes, street photography, architecture, still
                  life, macro, wildlife, sports, night scenes, and
                  astrophotography.
                </p>
                <span class="topic-keywords"
                  >Start with a scene. Find your own approach.</span
                >
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">C / 01</span>
              <div>
                <h2>Post-Processing</h2>
                <p>
                  Work with RAW files, tone, color management, and thoughtful
                  retouching.
                </p>
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">C / 02</span>
              <div>
                <h2>Workflow</h2>
                <p>
                  Plan your shoot, import and select images, back up, and
                  export.
                </p>
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">D / 01</span>
              <div>
                <h2>History of Photography</h2>
                <p>
                  Discover photographic technologies, movements, and influential
                  photographers.
                </p>
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">D / 02</span>
              <div>
                <h2>Photography Ethics</h2>
                <p>Understand etiquette, privacy, consent, and copyright.</p>
              </div>
            </article>

            <article class="topic-card" role="listitem">
              <span class="topic-index">D / 03</span>
              <div>
                <h2>Glossary</h2>
                <p>
                  Look up common photography terms, concepts, and abbreviations.
                </p>
              </div>
            </article>
          </div>
        </section>
</BaseLayout>


---
import GearLayout from '../../layouts/GearLayout.astro';
import GearList from '../../components/GearList.astro';
import { getGear } from '../../lib/gear';
const entries = await getGear();
const owned = entries.filter(({ data }) => data.status === 'owned');
---
<GearLayout title="Gear — MODAN / 漠澹" description="Tools for making photographs. A personal record of equipment, use, and time.">
  <header class="page-intro">
    <p class="eyebrow">MODAN / Field notes</p>
    <h1>Tools, over time.</h1>
    <p>A personal record of the cameras, lenses, and small things that accompany the photographs.</p>
  </header>
  <section aria-labelledby="current-heading">
    <div class="section-heading"><h2 id="current-heading">Currently owned</h2><span>{owned.length} {owned.length === 1 ? 'item' : 'items'}</span></div>
    {owned.length > 0 ? <GearList entries={owned} /> : <p class="empty">The record begins here. Equipment and notes will be added over time.</p>}
  </section>
</GearLayout>
<style>
  .page-intro .eyebrow { font-size: var(--font-size-caption); letter-spacing: var(--letter-spacing-label); margin-block-end: var(--space-6); }
  h1 { font-size: clamp(3rem, 6vw, 6rem); }
  section { margin-block-start: var(--section-spacing); }
  .section-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-4); }
  .section-heading span, .empty { color: var(--color-text-muted); }
  .section-heading span { font-size: var(--font-size-small); }
  .empty { border-block-start: 1px solid var(--color-border); padding-block: var(--space-7); margin-block-start: var(--space-5); }
</style>

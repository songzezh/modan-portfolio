---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getJournalEntries, formatJournalDate } from '../../lib/journal';
import { getImageSrcSet } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const entries = await getJournalEntries();
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, older: entries[index + 1], newer: entries[index - 1] },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, older, newer } = Astro.props;
const { Content } = await render(entry);
const { title, date, description, coverImage, location, tags, placeholder } = entry.data;
---

<BaseLayout title={`${title} — Journal — MODAN / 漠澹`} description={description}>
  <article aria-labelledby="entry-title">
    <header class="entry-header">
      <p class="metadata"><time datetime={date}>{formatJournalDate(date)}</time>{location && <> / {location}</>}</p>
      <h1 id="entry-title">{title}</h1>
      <p class="standfirst">{description}</p>
      {placeholder && <p class="metadata">Sample entry · Placeholder photography</p>}
    </header>
    <figure class:list={['entry-cover', `entry-cover--${coverImage.orientation}`]}>
      <img src={coverImage.src} srcset={getImageSrcSet(coverImage)}
        sizes={coverImage.orientation === 'portrait' ? '(min-width: 768px) 768px, 92vw' : '(min-width: 1600px) 1320px, 92vw'}
        width={coverImage.width} height={coverImage.height} alt={coverImage.alt} fetchpriority="high" />
      {coverImage.caption && <figcaption>{coverImage.caption}</figcaption>}
    </figure>
    <div class="reading-layout">
      <aside class="entry-margin" aria-label="Entry details">
        <p class="metadata">Visual journal</p>
        {tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map(tag => <li>{tag}</li>)}</ul>}
      </aside>
      <div class="journal-body"><Content /></div>
    </div>
  </article>
  <nav class="entry-navigation" aria-label="Journal navigation">
    {newer && <a href={`/journal/${newer.id}`}><span>Newer entry</span>{newer.data.title}</a>}
    <a class="journal-link" href="/journal">All journal entries</a>
    {older && <a href={`/journal/${older.id}`}><span>Older entry</span>{older.data.title}</a>}
  </nav>
</BaseLayout>

<style>
  .entry-header { max-inline-size: var(--content-width-text); margin-block-end: var(--space-8); }
  .metadata, .tags { color: var(--color-text-muted); font-size: var(--font-size-caption); }
  h1 { margin-block-end: var(--space-6); }
  .standfirst { font-family: var(--font-family-editorial); font-size: var(--font-size-lead); }
  .entry-cover { margin-block-end: var(--section-spacing); }
  .entry-cover img { inline-size: 100%; }
  .entry-cover--portrait { max-inline-size: var(--content-width-narrow); }
  .reading-layout { display: grid; gap: var(--space-7); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); padding: 0; list-style: none; }
  .journal-body { min-inline-size: 0; max-inline-size: var(--content-width-text); font-family: var(--font-family-editorial); font-size: var(--font-size-lead); overflow-wrap: anywhere; }
  .journal-body :global(h2), .journal-body :global(h3) { margin-block: var(--space-8) var(--space-5); }
  .journal-body :global(p), .journal-body :global(ul), .journal-body :global(ol) { margin-block-end: var(--space-6); }
  .journal-body :global(blockquote) { margin: var(--space-7) 0; padding-inline-start: var(--space-5); border-inline-start: 1px solid var(--color-border); font-style: italic; }
  .journal-body :global(img), .journal-body :global(figure) { margin-block: var(--image-gap); }
  .journal-body :global(pre) { max-inline-size: 100%; overflow-x: auto; font-size: var(--font-size-small); }
  .journal-body :global(table) { display: block; overflow-x: auto; max-inline-size: 100%; border-collapse: collapse; font-size: var(--font-size-small); }
  .journal-body :global(th), .journal-body :global(td) { padding: var(--space-3); border-block-end: 1px solid var(--color-border); text-align: start; }
  .entry-navigation { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-6); margin-block-start: var(--section-spacing); padding-block-start: var(--space-7); border-block-start: 1px solid var(--color-border); }
  .entry-navigation a { display: flex; flex-direction: column; gap: var(--space-2); max-inline-size: 28ch; padding-block: var(--space-3); color: var(--color-text); }
  .entry-navigation span { font-size: var(--font-size-caption); color: var(--color-text-muted); }
  .journal-link { font-size: var(--font-size-small); text-decoration: underline; }
  @media (min-width: 40rem) {
    .entry-cover { inline-size: 92%; margin-inline-start: auto; }
    .reading-layout { grid-template-columns: 1fr 3fr; gap: var(--space-8); }
  }
</style>

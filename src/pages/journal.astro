---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getJournalEntries, formatJournalDate } from '../lib/journal';
import { getImageSrcSet } from '../lib/projects';
const entries = await getJournalEntries();
---

<BaseLayout title="Journal — MODAN / 漠澹" description="The visual journal of MODAN / 漠澹.">
  <header class="page-intro">
    <h1>Journal</h1>
    <p>Notes on photography and observation.</p>
  </header>
  <ol class="journal-index" aria-label="Journal entries, newest first">
    {entries.map((entry, index) => {
      const { coverImage, title, description, date, location, tags, placeholder } = entry.data;
      const href = `/journal/${entry.id}`;
      return <li>
        <article class="journal-entry" aria-labelledby={`entry-${entry.id}`}>
          <a class:list={['entry-image', `entry-image--${coverImage.orientation}`]} href={href} aria-labelledby={`entry-${entry.id}`}>
            <img src={coverImage.src} srcset={getImageSrcSet(coverImage)}
              sizes="(min-width: 1600px) 864px, (min-width: 640px) 55vw, 92vw"
              width={coverImage.width} height={coverImage.height} alt={coverImage.alt}
              loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          </a>
          <div class="entry-note">
            <p class="metadata"><time datetime={date}>{formatJournalDate(date)}</time>{location && <> / {location}</>}</p>
            <h2 id={`entry-${entry.id}`}><a href={href}>{title}</a></h2>
            <p class="description">{description}</p>
            {tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map(tag => <li>{tag}</li>)}</ul>}
            {placeholder && <p class="metadata">Sample entry</p>}
          </div>
        </article>
      </li>;
    })}
  </ol>
  {entries.length === 0 && <p class="empty-state">New notes and photographs will appear here.</p>}
</BaseLayout>

<style>
  .journal-index { margin: var(--section-spacing) 0 0; padding: 0; list-style: none; }
  .journal-index > li + li { margin-block-start: var(--image-series-gap); }
  .journal-entry { display: grid; gap: var(--space-6); align-items: center; }
  .entry-image { display: block; }
  .entry-image img { inline-size: 100%; }
  .entry-image--portrait { inline-size: 80%; }
  .entry-note { max-inline-size: 36ch; }
  .metadata, .tags { color: var(--color-text-muted); font-size: var(--font-size-caption); }
  h2 { font-size: var(--font-size-heading); }
  h2 a { text-decoration: none; }
  h2 a:hover, h2 a:focus-visible { text-decoration: underline; }
  .description { font-family: var(--font-family-editorial); font-size: var(--font-size-lead); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); list-style: none; padding: 0; }
  .empty-state { margin-block-start: var(--space-8); }
  @media (min-width: 40rem) {
    .journal-entry { grid-template-columns: 3fr 2fr; gap: var(--image-gap); }
    .journal-index > li:nth-child(even) .journal-entry { grid-template-columns: 2fr 3fr; }
    .journal-index > li:nth-child(even) .entry-image { grid-column: 2; grid-row: 1; justify-self: end; }
    .journal-index > li:nth-child(even) .entry-note { grid-column: 1; grid-row: 1; }
  }
</style>

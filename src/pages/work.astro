---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getCoverImage, getImageSrcSet } from '../lib/projects';
import { projectCategories, projectCategoryLabels } from '../lib/project-categories';

const projects = await getProjects();
const categoryCounts = Object.fromEntries(projectCategories.map((category) => [
  category, projects.filter((project) => project.data.categories.includes(category)).length,
]));
---

<BaseLayout title="Work — MODAN / 漠澹" description="Photographic work by MODAN / 漠澹.">
  <div class="gallery" data-filter-gallery>
  <header class="work-header">
    <h1>Works<span class="title-divider" aria-hidden="true"> /</span></h1>
    <div class="filter-controls" data-filter-controls hidden>
      <ul class="filter-buttons" aria-label="Filter photography series">
        {projectCategories.map((category) => (
          <li>
            <button type="button" class="filter" data-filter={category} aria-pressed="false" aria-controls="work-series"
              aria-label={`${projectCategoryLabels[category]}, ${categoryCounts[category]} series`}>
              {projectCategoryLabels[category]}
            </button>
          </li>
        ))}
      </ul>
      <p class="filter-status" data-filter-status role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </header>
  <ol id="work-series" class="series-list" data-filter-list aria-label="Photography series">
    {projects.map((project, index) => {
      const image = getCoverImage(project);
      const href = `/work/${project.data.slug}`;
      return (
        <li class:list={['series', { 'series--alternate': index % 2 === 1 }]} data-categories={project.data.categories.join(' ')}>
          <div class="series-heading">
            <p class="series-number">{String(index + 1).padStart(2, '0')}</p>
            <h2 id={`series-${project.id}`}><a href={href}>{project.data.title}</a></h2>
            <p class="series-subtitle">{project.data.subtitle}</p>
            {(project.data.location || project.data.year) && <p class="series-meta">
              {project.data.location}
              {project.data.location && project.data.year && ' / '}
              {project.data.year && <time datetime={String(project.data.year)}>{project.data.year}</time>}
            </p>}
          </div>
          <a class:list={['series-image', `series-image--${image.orientation}`]}
            href={href} aria-labelledby={`series-${project.id}`}>
            <img src={image.src} srcset={getImageSrcSet(image)}
              sizes="(min-width: 1600px) 840px, (min-width: 640px) 55vw, 92vw"
              width={image.width} height={image.height} alt={image.alt}
              loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          </a>
        </li>
      );
    })}
  </ol>
  <p class="empty-state" data-filter-empty hidden={projects.length > 0}>New photography series will appear here.</p>
  </div>
</BaseLayout>

<script>
  import { initializeGalleryFilter } from '../scripts/gallery-filter';
  document.querySelectorAll<HTMLElement>('[data-filter-gallery]').forEach(initializeGalleryFilter);
</script>

<style>
  .series-list {
    margin: var(--section-spacing) 0 0;
    padding: 0;
    list-style: none;
  }
  .series:not([hidden]) ~ .series:not([hidden]) { margin-block-start: var(--image-series-gap); }
  .series { display: grid; gap: var(--space-6); }
  .gallery [hidden] { display: none; }
  .work-header {
    display: flex; flex-wrap: wrap;
    column-gap: var(--space-4); align-items: baseline;
    text-align: left;
  }
  .work-header h1 { margin: 0; }
  .work-header::after { content: ''; order: 1; flex-basis: 100%; }
  .title-divider { display: none; color: var(--color-text-muted); }
  .work-header:has([data-selected]) .title-divider { display: inline; }
  .filter-controls, .filter-buttons { display: contents; }
  .filter-buttons { margin: 0; padding: 0; list-style: none; }
  .filter-buttons li { order: 2; margin-block-start: var(--space-5); }
  .filter-controls[data-selected] li:has([aria-pressed='true']) { order: 1; margin-block-start: 0; }
  .filter {
    padding: var(--space-2) 0; min-block-size: 2.75rem; min-inline-size: 2.75rem;
    border: 0; border-radius: 0; background: transparent;
    color: var(--color-text-muted); font-family: var(--font-family-editorial); font-style: italic;
    font-size: var(--font-size-lead); line-height: var(--line-height-heading); letter-spacing: var(--letter-spacing-heading); cursor: pointer;
  }
  .filter[aria-pressed='true'] { padding: 0; font-size: var(--font-size-title); font-style: normal; font-weight: var(--font-weight-regular); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    .filter:hover { color: var(--color-primary); text-decoration: underline; text-underline-offset: 0.2em; }
    .series:has(.series-image:hover) h2 a { color: var(--color-primary-hover); text-decoration-line: underline; }
  }
  .series:has(.series-image:focus-visible) h2 a { color: var(--color-primary); text-decoration-line: underline; transition: none; }
  .filter-status { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .series-heading { max-inline-size: var(--content-width-text); }
  .series-number, .series-subtitle, .series-meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    margin-block-end: var(--space-3);
  }
  .series-number { margin-block-end: var(--space-5); }
  h2 { font-size: var(--font-size-heading); }
  h2 a { text-decoration-line: none; }
  h2 a:hover, h2 a:focus-visible { text-decoration-line: underline; }
  .series-image { display: block; align-self: start; }
  .series-image img { inline-size: 100%; }
  .series-image--portrait { inline-size: 80%; margin-inline-start: auto; }
  .empty-state { margin-block-start: var(--space-8); }
  @media (min-width: 40rem) {
    .series { grid-template-columns: 1fr 2fr; gap: var(--image-gap); }
    .series-heading { padding-block-start: var(--space-6); }
    .series--alternate { grid-template-columns: 2fr 1fr; }
    .series--alternate .series-heading { grid-column: 2; grid-row: 1; }
    .series--alternate .series-image { grid-column: 1; grid-row: 1; }
    .series-image--portrait { inline-size: 72%; margin-inline: 0 auto; }
    .series-image--square { inline-size: 86%; }
  }
</style>

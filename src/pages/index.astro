---
import BaseLayout from '../layouts/BaseLayout.astro';

import { getHomepageProjects, getCoverImage, getImageSrcSet } from '../lib/projects';

const { lead, selected } = await getHomepageProjects();
const leadImage = lead && getCoverImage(lead);
---

<BaseLayout title="MODAN / 漠澹" description="A photography portfolio and visual journal.">
  <header class="identity">
    <div>
      <p class="eyebrow">Photography &amp; visual journal</p>
      <h1>MODAN <span class="identity-divider" aria-hidden="true">/</span> <span lang="zh-Hans">漠澹</span></h1>
    </div>
    <p class="identity-note">A place for looking.<br />For what stays, quietly.</p>
  </header>

  {lead && leadImage && <figure class="opening-photograph">
    <img
      src={leadImage.src}
      srcset={getImageSrcSet(leadImage)}
      sizes="(min-width: 1600px) 1320px, (min-width: 640px) 84vw, 92vw"
      width={leadImage.width} height={leadImage.height}
      alt={leadImage.alt}
      fetchpriority="high"
    />
    <figcaption>
      <span>{lead.data.title}</span><span>{lead.data.subtitle}</span>
      {leadImage.caption && <span>{leadImage.caption}</span>}
    </figcaption>
  </figure>}

  {selected.length > 0 && <section class="selected-works" aria-labelledby="selected-heading">
    <header class="section-heading">
      <h2 id="selected-heading">Selected works</h2>
      <a href="/work">All work <span aria-hidden="true">↗</span></a>
    </header>

    <div class="photograph-pair">
      {selected.map((project, index) => {
        const image = getCoverImage(project);
        return (
          <figure class:list={['work-photograph', `work-photograph--${image.orientation}`]}>
            <img
              src={image.src}
              srcset={getImageSrcSet(image)}
              sizes="(min-width: 1600px) 600px, (min-width: 640px) 42vw, 80vw"
              width={image.width} height={image.height}
              alt={image.alt}
              loading="lazy" decoding="async"
            />
            <figcaption>
              <span>{String(index + 1).padStart(2, '0')} — <a href={`/work/${project.data.slug}`}>{project.data.title}</a></span>
              <span>{project.data.subtitle}</span>
              {image.caption && <span>{image.caption}</span>}
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>}

  <section class="journal-note" aria-labelledby="journal-heading">
    <h2 class="eyebrow" id="journal-heading">From the visual journal</h2>
    <div class="journal-copy">
      <p>Not everything needs a story.<br />Sometimes, it is enough to notice.</p>
      <p class="journal-description">Fragments of light, places passed through, and the small things that ask us to look again.</p>
      <a href="/journal">Read the journal <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .identity {
    display: grid;
    gap: var(--space-6);
    margin-block-end: var(--space-8);
  }

  .eyebrow {
    margin-block: 0 var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-family-body);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-caption);
    letter-spacing: var(--letter-spacing-label);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.5rem);
  }

  .identity-divider {
    margin-inline: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-heading);
    vertical-align: middle;
  }

  .identity-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  img {
    inline-size: 100%;
    background-color: var(--color-surface);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .selected-works {
    margin-block-start: var(--image-series-gap);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-end: var(--space-7);
  }

  .section-heading h2 {
    margin: 0;
    font-size: var(--font-size-heading-small);
  }

  .section-heading a,
  .journal-copy a {
    display: inline-block;
    padding-block: var(--space-3);
    font-size: var(--font-size-small);
  }

  a span {
    margin-inline-start: var(--space-2);
  }

  .photograph-pair {
    display: grid;
    gap: var(--image-series-gap);
  }

  .work-photograph {
    inline-size: 86%;
  }

  .work-photograph--landscape {
    inline-size: 86%;
    justify-self: end;
  }

  .journal-note {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--section-spacing);
    padding-block-start: var(--space-7);
    border-block-start: 1px solid var(--color-border);
  }

  .journal-copy {
    max-inline-size: var(--content-width-text);
  }

  .journal-copy > p:first-child {
    font-family: var(--font-family-editorial);
    font-size: var(--font-size-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    margin-block-end: var(--space-6);
  }

  .journal-description {
    max-inline-size: 34ch;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  /* Matches --breakpoint-small. */
  @media (min-width: 40rem) {
    .identity {
      grid-template-columns: 2fr 1fr;
      align-items: end;
      margin-block-end: var(--space-9);
    }

    .identity-note {
      justify-self: end;
    }

    .opening-photograph {
      inline-size: 92%;
      margin-inline-start: auto;
    }

    .photograph-pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      column-gap: var(--image-series-gap);
    }

    .work-photograph {
      inline-size: 100%;
    }

    .work-photograph--landscape {
      margin-block-start: var(--section-spacing);
    }

    .journal-note {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-7);
      padding-block: var(--space-8) var(--space-7);
    }
  }
</style>
